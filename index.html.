.meta span{font-size:12px;color:var(--muted)}a{display:block;margin:0 12px 14px;padding:11px;text-align:center;background:#173c20;color:var(--green);text-decoration:none;border-radius:9px;font-weight:bold}
footer{text-align:center;color:var(--muted);padding:30px}
