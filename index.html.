}
header{
background:linear-gradient(135deg,#061b0b,#107c10,#061b0b);
padding:40px 15px;
text-align:center;
}
header h1{font-size:30px}
header p{color:#ddd}
h2{text-align:center;color:#39e75b}
.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
gap:20px;
padding:20px;
}
.card{
background:#171d29;
border-radius:15px;
padding:12px;
text-align:center;
}
.card img{
width:100%;
height:180px;
object-fit:cover;
border-radius:10px;
}
.card a{
display:block;
background:#107c10;
color:white;
padding:12px;
border-radius:8px;
text-decoration:none;
margin-top:10px;
}
footer{
text-align:center;
padding:30px;
color:#888;
